# BuySmart Environment Configuration

# Database Configuration (PostgreSQL with pgvector)
# Format: postgresql://username:password@localhost:5432/buysmart_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buysmart_db

# Alternative SQLite fallback for testing without Postgres server installed:
# DATABASE_URL=sqlite:///./buysmart.db

# Security & Authentication
SECRET_KEY=buysmart_super_secure_jwt_secret_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI & RAG Configuration
# Google Gemini API key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Embeddings (Sentence Transformers model)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Document Chunker Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Server Environment
APP_NAME=BuySmart AI E-Commerce
APP_ENV=development
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
